# Local development template for @workspace/api-server.
# Copy to `.env` in this directory and fill in real values:
#
#   cp artifacts/api-server/.env.example artifacts/api-server/.env
#
# `.env` is gitignored — NEVER commit real credentials.
# All values below are placeholders, not working secrets.

# Postgres connection string used by @workspace/db (required — src/index.ts of
# @workspace/db throws at import time if this is unset).
DATABASE_URL="postgresql://forge_dev:replace_me@localhost:5432/forge_dev"

# Port the API server listens on (required — artifacts/api-server/src/index.ts
# throws if this is unset). Note: in Docker this is fixed at 3001 by the
# Dockerfile's `ENV PORT=3001`; this value is for local `pnpm dev` only.
PORT=3000

# Base URL the frontend dev server calls. Must match PORT above.
VITE_API_URL="http://localhost:3000/api"

# Optional. Signing key for session cookies. The API falls back to a hardcoded
# development default when unset — always set a long random value in production.
# JWT_SECRET="replace_with_a_long_random_string"

# Optional. Allowed CORS origin for the API.
# CORS_ORIGIN="http://localhost:5173"

# Optional. Sentry DSN; error reporting stays disabled when unset.
# SENTRY_DSN=""
