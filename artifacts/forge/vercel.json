{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --filter @workspace/forge... && pnpm --filter @workspace/forge build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.symbiosystech.in/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
