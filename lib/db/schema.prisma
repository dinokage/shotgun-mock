  annotations         Annotation[]
  assets              Asset[]
  auditLogs           AuditLog[]
  clientAccessLinks   ClientAccessLink[]
  dailyLogs           DailyLog[]
  departments         Department[]
  episodes            Episode[]
  notifications       Notification[]
  pendingInvites      PendingInvite[]
  projects            Project[]
  reviews             Review[]
  sequenceTeamMembers SequenceTeamMember[]
  sequences           Sequence[]
  shots               Shot[]
  standupUpdates      StandupUpdate[]
  taskApprovalEvents  TaskApprovalEvent[]
  taskAttachments     TaskAttachment[]
  taskChecklistItems  TaskChecklistItem[]
  taskComments        TaskComment[]
  taskDependencies    TaskDependency[]
  tasks               Task[]
  tenantRoles         TenantRole[]
  users               User[]
  versions            Version[]
  pipelineTemplates   PipelineTemplate[]
  pipelineStages      PipelineStage[]
  projectPipelines    ProjectPipeline[]
  chatChannels        ChatChannel[]
  chatChannelMembers  ChatChannelMember[]
  chatMessages        ChatMessage[]
  deliveries          Delivery[]
  deliveryItems       DeliveryItem[]
  deliveryDownloads   DeliveryDownload[]
  publishLogs         PublishLog[]
  studioSettings      StudioSetting[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  licenseServers      LicenseServer[]
  integrations        Integration[]
  entityTypeDefs      EntityTypeDef[]
  entityFieldDefs     EntityFieldDef[]
  taskTemplates       TaskTemplate[]
  taskTemplateItems   TaskTemplateItem[]
  workflows           Workflow[]
  workflowRuns        WorkflowRun[]
  tenantPlugins       TenantPlugin[]
  trackingViews       TrackingView[]
  notificationPrefs   NotificationPreference[]
  standupPlaylist     StandupPlaylistItem[]
  standupApprovals    StandupApproval[]
  assetActivity       AssetActivity[]
  reviewPresentations ReviewPresentation[]
  reviewComments      ReviewComment[]
  clientNotes         ClientNote[]
  broadcasts          Broadcast[]
  auditRollbacks      AuditRollback[]
  passwordResetTokens PasswordResetToken[]
  attendanceRecords   AttendanceRecord[]

  @@map("tenants")
}

model User {
  id             String    @id
  tenantId       String    @map("tenant_id")
  roleId         String    @map("role_id")
  email          String    @unique(map: "users_email_unique")
  hashedPassword String    @map("hashed_password")
  name           String
  title          String?
  avatar         String?
  status         String?   @default("active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)
  departmentId   String?   @map("department_id")
  punchedInAt    DateTime? @map("punched_in_at") @db.Timestamp(6)
  /// Bumped on every authenticated request (throttled, see tenant.ts), never
  /// cleared. This is the "online" signal, deliberately separate from
  /// punchedInAt -- clocking in is an attendance/payroll fact that survives
  /// closing the laptop; being online is only true while requests keep
  /// arriving, so a closed tab silently ages out instead of staying "active"
  /// forever waiting for a logout click that may never come.
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamp(6)
  /// When this user finished (or skipped) the first-run walkthrough. Null
  /// means they have never been shown it. Stored per user rather than in
  /// browser storage so the tour does not reappear every time someone signs
  /// in from a different machine, which is normal in a shared studio.
  onboardedAt    DateTime? @map("onboarded_at") @db.Timestamp(6)
  /// The role this person asked for when they registered, when that role
  /// carries more authority than the one they were actually given. The
  /// account is always created at least privilege; this records the claim so
  /// an administrator can approve it deliberately. Cleared once resolved, so
  /// a non-null value means "awaiting a decision".
  requestedRole  String?   @map("requested_role")
  /// Bumped to invalidate every session this user holds. Sessions are
  /// stateless JWTs with a 7-day life, so without this a logout, a password
  /// change, or an offboarding left existing tokens usable for up to a week.
  /// Every request compares the value in the token against this column.
  tokenVersion   Int       @default(0) @map("token_version")

  annotations               Annotation[]
  assets                    Asset[]
  clientAccessLinks         ClientAccessLink[]
  dailyLogs                 DailyLog[]
  notifications             Notification[]
  reviews                   Review[]
  sequenceTeamMembers       SequenceTeamMember[]
  shots                     Shot[]
  standupUpdates            StandupUpdate[]
  taskApprovalEvents        TaskApprovalEvent[]
  taskAttachments           TaskAttachment[]
  taskComments              TaskComment[]
  department                Department?              @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "users_department_id_departments_id_fk")
  role                      TenantRole               @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "users_role_id_tenant_roles_id_fk")
  tenant                    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "users_tenant_id_tenants_id_fk")
  versions                  Version[]
  chatChannels              ChatChannel[]
  chatChannelMembers        ChatChannelMember[]
  chatMessages              ChatMessage[]
  deliveries                Delivery[]
  publishLogs               PublishLog[]
  studioSettings            StudioSetting[]
  apiKeys                   ApiKey[]
  webhooks                  Webhook[]
  integrations              Integration[]
  entityTypeDefs            EntityTypeDef[]
  taskTemplates             TaskTemplate[]
  workflows                 Workflow[]
  workflowRuns              WorkflowRun[]
  tenantPlugins             TenantPlugin[]
  trackingViews             TrackingView[]
  notificationPrefs         NotificationPreference[]
  standupPlaylist           StandupPlaylistItem[]
  standupApprovals          StandupApproval[]
  assetActivity             AssetActivity[]
  reviewPresentations       ReviewPresentation[]
  reviewCommentsAuthored    ReviewComment[]          @relation("ReviewCommentAuthor")
  reviewCommentsTransferred ReviewComment[]          @relation("ReviewCommentTransferrer")
  clientNotesTransferred    ClientNote[]
  broadcasts                Broadcast[]
  auditRollbacks            AuditRollback[]
  passwordResetTokens       PasswordResetToken[]
  attendanceRecords         AttendanceRecord[]

  @@map("users")
}

model Version {
  id            String   @id
  tenantId      String   @map("tenant_id")
  taskId        String?  @map("task_id")
  mediaUrl      String   @map("media_url")
  status        String   @default("pending_review")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  entityId      String   @map("entity_id")
  entityType    String   @map("entity_type")
  versionNumber String   @default("v001") @map("version_number")
  notes         String   @default("")
  thumbnail     String?
  derivedFromId String?  @map("derived_from_id")
  fileSize      String   @default("0MB") @map("file_size")
  createdById   String?  @map("created_by_id")

  annotations         Annotation[]
  clientAccessLinks   ClientAccessLink[]
  reviews             Review[]
  createdBy           User?                @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "versions_created_by_id_users_id_fk")
  task                Task?                @relation(fields: [taskId], references: [id], onUpdate: NoAction, map: "versions_task_id_tasks_id_fk")
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "versions_tenant_id_tenants_id_fk")
  reviewPresentations ReviewPresentation[]
  reviewComments      ReviewComment[]
  clientNotes         ClientNote[]

  @@map("versions")
}

// ---------------------------------------------------------------------------
// Configurable production pipeline
//
// There is no canonical stage ordering in this industry: Autodesk's Flow
// Production Tracking ships no default step list at all and makes display
// order an author-supplied field, and both Flow and AYON scope steps per
// entity type with per-project enable/disable. So a pipeline is a template of
// ordered stages, and each project may reorder or switch off stages without
// forking the template.
// ---------------------------------------------------------------------------

model PipelineTemplate {
  id          String   @id
  tenantId    String   @map("tenant_id")
  name        String
  /// "3d" | "2d" | "vfx" — which discipline this template describes.
  discipline  String
  /// "shot" | "asset" — asset stages and shot stages are separate tracks.
  entityKind  String   @map("entity_kind")
  description String   @default("")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pipeline_templates_tenant_id_tenants_id_fk")
  stages   PipelineStage[]
  projects ProjectPipeline[]

  @@map("pipeline_templates")
}

model PipelineStage {
  id             String  @id
  tenantId       String  @map("tenant_id")
  templateId     String  @map("template_id")
  name           String
  shortCode      String  @map("short_code")
  sortOrder      Int     @map("sort_order")
  /// The department that owns this stage, when one exists in this tenant.
  departmentId   String? @map("department_id")
  isOptional     Boolean @default(false) @map("is_optional")
  /// Deliverable extensions, e.g. [".mov", ".exr"].
  outputFormats  Json    @default("[]") @map("output_formats")
  /// Whether the artist keeps a local copy alongside the review copy.
  keepsLocalCopy Boolean @default(false) @map("keeps_local_copy")
  /// Who reviews this stage, e.g. ["lead", "production_head", "producer"].
  reviewAudience Json    @default("[]") @map("review_audience")
  /// "shot" | "asset" | null — which DCC publish this stage performs.
  dccPublishKind String? @map("dcc_publish_kind")

  template   PipelineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pipeline_stages_template_id_fk")
  department Department?      @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "pipeline_stages_department_id_fk")
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "pipeline_stages_tenant_id_tenants_id_fk")
  tasks      Task[]

  @@index([templateId, sortOrder])
  @@map("pipeline_stages")
}

model ProjectPipeline {
  id             String   @id
  tenantId       String   @map("tenant_id")
  projectId      String   @map("project_id")
  templateId     String   @map("template_id")
  /// Per-project reorder and enable/disable, keyed by stage id:
  /// { "<stageId>": { "sortOrder": 3, "enabled": false } }.
  /// Stored as overrides rather than a copied stage list so a template edit
  /// still reaches every project that hasn't deliberately diverged.
  stageOverrides Json     @default("{}") @map("stage_overrides")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_pipelines_project_id_fk")
  template PipelineTemplate @relation(fields: [templateId], references: [id], onUpdate: NoAction, map: "project_pipelines_template_id_fk")
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_pipelines_tenant_id_tenants_id_fk")

  @@unique([projectId, templateId])
  @@map("project_pipelines")
}

// ---------------------------------------------------------------------------
// Subsystems that previously lived only in browser localStorage, so two people
// on two machines saw different data and neither was wrong. Chat messages were
// never delivered, delivery access codes could not be redeemed from another
// browser, and publish logs vanished with the tab.
// ---------------------------------------------------------------------------

model ChatChannel {
  id           String    @id
  tenantId     String    @map("tenant_id")
  /// "channel" | "group" | "dm"
  kind         String    @default("channel")
  name         String
  description  String    @default("")
  departmentId String?   @map("department_id")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  archivedAt   DateTime? @map("archived_at") @db.Timestamp(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_channels_tenant_id_fk")
  createdBy User?               @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "chat_channels_created_by_id_fk")
  members   ChatChannelMember[]
  messages  ChatMessage[]

  @@map("chat_channels")
}

model ChatChannelMember {
  id         String    @id
  tenantId   String    @map("tenant_id")
  channelId  String    @map("channel_id")
  userId     String    @map("user_id")
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamp(6)
  /// Drives unread badges without scanning the whole message history.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamp(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_channel_members_tenant_id_fk")
  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_channel_members_channel_id_fk")
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_channel_members_user_id_fk")

  @@unique([channelId, userId])
  @@map("chat_channel_members")
}

model ChatMessage {
  id             String    @id
  tenantId       String    @map("tenant_id")
  channelId      String    @map("channel_id")
  authorId       String?   @map("author_id")
  body           String    @default("")
  attachmentUrl  String?   @map("attachment_url")
  attachmentName String?   @map("attachment_name")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  editedAt       DateTime? @map("edited_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_messages_tenant_id_fk")
  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_messages_channel_id_fk")
  author  User?       @relation(fields: [authorId], references: [id], onUpdate: NoAction, map: "chat_messages_author_id_fk")

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

model Delivery {
  id          String    @id
  tenantId    String    @map("tenant_id")
  projectId   String?   @map("project_id")
  name        String
  notes       String    @default("")
  /// Redeemed by an external recipient at /delivery/:id — must be unique and
  /// unguessable, same contract as ClientAccessLink.code.
  accessCode  String    @unique(map: "deliveries_access_code_unique") @map("access_code")
  status      String    @default("draft")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "deliveries_tenant_id_fk")
  project   Project?           @relation(fields: [projectId], references: [id], onUpdate: NoAction, map: "deliveries_project_id_fk")
  createdBy User?              @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "deliveries_created_by_id_fk")
  items     DeliveryItem[]
  downloads DeliveryDownload[]

  @@map("deliveries")
}

model DeliveryItem {
  id         String  @id
  tenantId   String  @map("tenant_id")
  deliveryId String  @map("delivery_id")
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")
  versionId  String? @map("version_id")
  fileName   String  @map("file_name")
  fileSize   String  @default("0MB") @map("file_size")
  mediaUrl   String  @default("") @map("media_url")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_items_tenant_id_fk")
  delivery  Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_items_delivery_id_fk")
  downloads DeliveryDownload[]

  @@map("delivery_items")
}

model DeliveryDownload {
  id           String   @id
  tenantId     String   @map("tenant_id")
  deliveryId   String   @map("delivery_id")
  itemId       String?  @map("item_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.Timestamp(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_downloads_tenant_id_fk")
  delivery Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "delivery_downloads_delivery_id_fk")
  item     DeliveryItem? @relation(fields: [itemId], references: [id], onUpdate: NoAction, map: "delivery_downloads_item_id_fk")

  @@map("delivery_downloads")
}

model PublishLog {
  id            String   @id
  tenantId      String   @map("tenant_id")
  /// "shot" | "asset" — mirrors the DCC's shot-publish vs asset-publish split.
  publishKind   String   @map("publish_kind")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  taskId        String?  @map("task_id")
  versionId     String?  @map("version_id")
  publishedById String?  @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamp(6)
  status        String   @default("queued")
  fileName      String   @default("")
  fileSize      String   @default("0MB") @map("file_size")
  notes         String   @default("")
  /// Pre-publish validator output, one entry per check.
  validationLog Json     @default("[]") @map("validation_log")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "publish_logs_tenant_id_fk")
  publishedBy User?  @relation(fields: [publishedById], references: [id], onUpdate: NoAction, map: "publish_logs_published_by_id_fk")

  @@index([entityId, publishedAt])
  @@map("publish_logs")
}

/// Generic tenant-scoped key/value settings (studio profile, security policy,
/// pipeline paths). One table rather than six near-empty ones, because these
/// are read as whole documents and never queried by their inner fields.
model StudioSetting {
  id          String   @id
  tenantId    String   @map("tenant_id")
  key         String
  value       Json     @default("{}")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedById String?  @map("updated_by_id")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "studio_settings_tenant_id_fk")
  updatedBy User?  @relation(fields: [updatedById], references: [id], onUpdate: NoAction, map: "studio_settings_updated_by_id_fk")

  @@unique([tenantId, key])
  @@map("studio_settings")
}

model ApiKey {
  id          String    @id
  tenantId    String    @map("tenant_id")
  name        String
  /// Only the hash is stored; the token itself is shown once at creation and
  /// is unrecoverable afterwards.
  tokenHash   String    @map("token_hash")
  /// Short non-secret prefix so a key is identifiable in a list.
  tokenPrefix String    @map("token_prefix")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamp(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_keys_tenant_id_fk")
  createdBy User?  @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "api_keys_created_by_id_fk")

  @@map("api_keys")
}

model Webhook {
  id          String    @id
  tenantId    String    @map("tenant_id")
  url         String
  events      Json      @default("[]")
  secret      String    @default("")
  isActive    Boolean   @default(true) @map("is_active")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  lastFiredAt DateTime? @map("last_fired_at") @db.Timestamp(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "webhooks_tenant_id_fk")
  createdBy User?  @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "webhooks_created_by_id_fk")

  @@map("webhooks")
}

model LicenseServer {
  id         String   @id
  tenantId   String   @map("tenant_id")
  name       String
  vendor     String   @default("")
  host       String   @default("")
  port       Int?
  seatsTotal Int      @default(0) @map("seats_total")
  seatsInUse Int      @default(0) @map("seats_in_use")
  status     String   @default("unknown")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "license_servers_tenant_id_fk")

  @@map("license_servers")
}

model Integration {
  id            String    @id
  tenantId      String    @map("tenant_id")
  /// "maya" | "blender" | "nuke" | "houdini" | ...
  provider      String
  displayName   String    @map("display_name")
  status        String    @default("disconnected")
  config        Json      @default("{}")
  autoSync      Boolean   @default(false) @map("auto_sync")
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamp(6)
  connectedById String?   @map("connected_by_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "integrations_tenant_id_fk")
  connectedBy User?  @relation(fields: [connectedById], references: [id], onUpdate: NoAction, map: "integrations_connected_by_id_fk")

  @@unique([tenantId, provider])
  @@map("integrations")
}

// ---------------------------------------------------------------------------
// The last of the browser-localStorage subsystems. Each of these looked like
// shared studio state and behaved like a private per-device note: a schema an
// admin designed, a workflow someone wired up, a saved tracking view, a
// dailies playlist, a broadcast meant to reach the client portal.
// ---------------------------------------------------------------------------

model EntityTypeDef {
  id          String   @id
  tenantId    String   @map("tenant_id")
  name        String
  /// lucide-react icon name, resolved at render time.
  icon        String   @default("Box")
  color       String   @default("")
  description String   @default("")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entity_type_defs_tenant_id_fk")
  createdBy User?            @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "entity_type_defs_created_by_id_fk")
  fields    EntityFieldDef[]

  @@unique([tenantId, name])
  @@map("entity_type_defs")
}

model EntityFieldDef {
  id           String  @id
  tenantId     String  @map("tenant_id")
  entityTypeId String  @map("entity_type_id")
  /// Stable snake_case identifier that computed expressions reference. It is
  /// unique per entity type because an expression resolves by key alone.
  key          String
  label        String
  /// text | number | date | boolean | single_select | multi_select | computed
  type         String
  required     Boolean @default(false)
  description  String  @default("")
  /// Choices for single_select / multi_select.
  options      Json    @default("[]")
  defaultValue String? @map("default_value")
  /// computed fields only.
  expression   String?
  sortOrder    Int     @default(0) @map("sort_order")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entity_field_defs_tenant_id_fk")
  entityType EntityTypeDef @relation(fields: [entityTypeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entity_field_defs_entity_type_id_fk")

  @@unique([entityTypeId, key])
  @@map("entity_field_defs")
}

model TaskTemplate {
  id          String   @id
  tenantId    String   @map("tenant_id")
  name        String
  description String   @default("")
  icon        String   @default("ListChecks")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_templates_tenant_id_fk")
  createdBy User?              @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "task_templates_created_by_id_fk")
  items     TaskTemplateItem[]

  @@map("task_templates")
}

model TaskTemplateItem {
  id             String  @id
  tenantId       String  @map("tenant_id")
  templateId     String  @map("template_id")
  title          String
  departmentId   String? @map("department_id")
  estimatedHours Int     @default(0) @map("estimated_hours")
  priority       String  @default("medium")
  sortOrder      Int     @default(0) @map("sort_order")

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_template_items_tenant_id_fk")
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_template_items_template_id_fk")
  department Department?  @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "task_template_items_department_id_fk")

  @@map("task_template_items")
}

model Workflow {
  id          String   @id
  tenantId    String   @map("tenant_id")
  name        String
  description String   @default("")
  /// What starts a run, e.g. "New Version" / "Status Change".
  trigger     String   @default("")
  status      String   @default("draft")
  /// The React Flow graph: { nodes: [...], edges: [...] }. Stored whole
  /// because the editor reads and writes it as one document and nothing
  /// queries individual nodes.
  graph       Json     @default("{\"nodes\":[],\"edges\":[]}")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflows_tenant_id_fk")
  createdBy User?         @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "workflows_created_by_id_fk")
  runs      WorkflowRun[]

  @@map("workflows")
}

model WorkflowRun {
  id            String    @id
  tenantId      String    @map("tenant_id")
  workflowId    String    @map("workflow_id")
  status        String    @default("running")
  currentNode   String    @default("") @map("current_node")
  triggeredById String?   @map("triggered_by_id")
  entityId      String?   @map("entity_id")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt   DateTime? @map("completed_at") @db.Timestamp(6)
  /// Append-only run log: [{ timestamp, node, message, status }].
  logs          Json      @default("[]")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflow_runs_tenant_id_fk")
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "workflow_runs_workflow_id_fk")
  triggeredBy User?    @relation(fields: [triggeredById], references: [id], onUpdate: NoAction, map: "workflow_runs_triggered_by_id_fk")

  @@index([workflowId, startedAt])
  @@map("workflow_runs")
}

/// Per-tenant install/enable state for a marketplace plugin. The catalogue
/// itself is static product data; only what this studio has turned on is
/// tenant state.
model TenantPlugin {
  id            String   @id
  tenantId      String   @map("tenant_id")
  pluginId      String   @map("plugin_id")
  installed     Boolean  @default(true)
  enabled       Boolean  @default(true)
  installedById String?  @map("installed_by_id")
  installedAt   DateTime @default(now()) @map("installed_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tenant_plugins_tenant_id_fk")
  installedBy User?  @relation(fields: [installedById], references: [id], onUpdate: NoAction, map: "tenant_plugins_installed_by_id_fk")

  @@unique([tenantId, pluginId])
  @@map("tenant_plugins")
}

model TrackingView {
  id        String   @id
  tenantId  String   @map("tenant_id")
