  userId    String   @map("user_id")
  name      String
  /// The full filter/grouping/sort configuration the Tracking Grid restores.
  filters   Json     @default("{}")
  isShared  Boolean  @default(false) @map("is_shared")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tracking_views_tenant_id_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tracking_views_user_id_fk")

  @@map("tracking_views")
}

model NotificationPreference {
  id       String  @id
  tenantId String  @map("tenant_id")
  userId   String  @map("user_id")
  category String
  push     Boolean @default(true)
  email    Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notification_preferences_tenant_id_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notification_preferences_user_id_fk")

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// The Dailies playlist is one shared queue per tenant — the point of a
/// dailies session is that everyone watches the same list in the same order.
model StandupPlaylistItem {
  id        String   @id
  tenantId  String   @map("tenant_id")
  taskId    String   @map("task_id")
  sortOrder Int      @default(0) @map("sort_order")
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "standup_playlist_items_tenant_id_fk")
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "standup_playlist_items_task_id_fk")
  addedBy User?  @relation(fields: [addedById], references: [id], onUpdate: NoAction, map: "standup_playlist_items_added_by_id_fk")

  @@unique([tenantId, taskId])
  @@map("standup_playlist_items")
}

/// An acknowledgement on a standup feed item. `feedItemId` is a plain string,
/// not an FK: the feed mixes standup updates with other sources, so a
/// constraint here would reject valid acknowledgements.
model StandupApproval {
  id         String   @id
  tenantId   String   @map("tenant_id")
  feedItemId String   @map("feed_item_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "standup_approvals_tenant_id_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "standup_approvals_user_id_fk")

  @@unique([feedItemId, userId])
  @@map("standup_approvals")
}

/// Append-only trace of what someone did to an asset outside this app —
/// opened it in a DCC, or published it by hand. Kept as a log rather than a
/// latest-only field so attribution survives the next person's action.
model AssetActivity {
  id        String   @id
  tenantId  String   @map("tenant_id")
  assetId   String   @map("asset_id")
  /// "dcc_open" | "publish"
  kind      String
  /// DCC application name, for dcc_open.
  app       String?
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "asset_activity_tenant_id_fk")
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "asset_activity_asset_id_fk")
  user   User?  @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "asset_activity_user_id_fk")

  @@index([assetId, createdAt])
  @@map("asset_activity")
}

/// Who currently has the floor in a review session. One row per version, so
/// two people can't both be presenting the same version.
model ReviewPresentation {
  id            String   @id
  tenantId      String   @map("tenant_id")
  versionId     String   @map("version_id")
  presenterId   String?  @map("presenter_id")
  presenterName String   @default("") @map("presenter_name")
  frame         Int      @default(1)
  isActive      Boolean  @default(false) @map("is_active")
  startedAt     DateTime @default(now()) @map("started_at") @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "review_presentations_tenant_id_fk")
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "review_presentations_version_id_fk")
  presenter User?   @relation(fields: [presenterId], references: [id], onUpdate: NoAction, map: "review_presentations_presenter_id_fk")

  @@unique([tenantId, versionId])
  @@map("review_presentations")
}

/// A note on the review player's timeline. Distinct from Annotation, which
/// holds the drawn marks; this is the written/spoken feedback stream.
model ReviewComment {
  id                   String    @id
  tenantId             String    @map("tenant_id")
  versionId            String    @map("version_id")
  authorId             String?   @map("author_id")
  frame                Int       @default(1)
  text                 String    @default("")
  /// Uploaded voice note. A browser blob: URL does not survive a reload, so
  /// anything durable has to be a real uploaded file.
  audioUrl             String?   @map("audio_url")
  /// Amplitude samples captured during recording, for the waveform.
  waveform             Json      @default("[]")
  /// Drawn marks carried over when a client note is transferred in.
  annotations          Json      @default("[]")
  /// Set only on comments transferred in from a client note — client
  /// feedback never reaches this stream automatically.
  fromClientAuthorName String?   @map("from_client_author_name")
  fromClientShotName   String?   @map("from_client_shot_name")
  transferredById      String?   @map("transferred_by_id")
  transferredAt        DateTime? @map("transferred_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "review_comments_tenant_id_fk")
  version       Version @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "review_comments_version_id_fk")
  author        User?   @relation("ReviewCommentAuthor", fields: [authorId], references: [id], onUpdate: NoAction, map: "review_comments_author_id_fk")
  transferredBy User?   @relation("ReviewCommentTransferrer", fields: [transferredById], references: [id], onUpdate: NoAction, map: "review_comments_transferred_by_id_fk")

  @@index([versionId, frame])
  @@map("review_comments")
}

/// A note left in the client portal. Deliberately NOT visible to the internal
/// team until someone transfers it into the review comment stream — that
/// moderation gate is the feature, not an oversight.
model ClientNote {
  id                 String    @id
  tenantId           String    @map("tenant_id")
  shotId             String    @map("shot_id")
  versionId          String?   @map("version_id")
  frame              Int       @default(1)
  text               String    @default("")
  authorName         String    @default("") @map("author_name")
  clientAccessLinkId String?   @map("client_access_link_id")
  annotations        Json      @default("[]")
  transferred        Boolean   @default(false)
  transferredAt      DateTime? @map("transferred_at") @db.Timestamp(6)
  transferredById    String?   @map("transferred_by_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_notes_tenant_id_fk")
  shot             Shot              @relation(fields: [shotId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_notes_shot_id_fk")
  version          Version?          @relation(fields: [versionId], references: [id], onUpdate: NoAction, map: "client_notes_version_id_fk")
  clientAccessLink ClientAccessLink? @relation(fields: [clientAccessLinkId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "client_notes_client_access_link_id_fk")
  transferredBy    User?             @relation(fields: [transferredById], references: [id], onUpdate: NoAction, map: "client_notes_transferred_by_id_fk")

  @@index([shotId, createdAt])
  @@map("client_notes")
}

model Broadcast {
  id        String   @id
  tenantId  String   @map("tenant_id")
  authorId  String?  @map("author_id")
  text      String
  /// "internal" | "internal_and_client" — the latter also surfaces on the
  /// client portal for `projectId`, the only bridge to that external surface.
  audience  String   @default("internal")
  projectId String?  @map("project_id")
  /// "info" | "success" | "warning"
  severity  String   @default("info")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "broadcasts_tenant_id_fk")
  author  User?    @relation(fields: [authorId], references: [id], onUpdate: NoAction, map: "broadcasts_author_id_fk")
  project Project? @relation(fields: [projectId], references: [id], onUpdate: NoAction, map: "broadcasts_project_id_fk")

  @@index([tenantId, createdAt])
  @@map("broadcasts")
}

/// Where an entity has been rolled back to in Time Travel, plus the field
/// values captured immediately before the first rollback in a chain — that
/// snapshot is what "Restore latest" puts back.
/// A single-use password-reset grant. Only the hash of the token is stored,
/// the same way API keys are handled -- a leaked database dump must not hand
/// an attacker a working reset link for every account.
model PasswordResetToken {
  id          String    @id
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  tokenHash   String    @unique(map: "password_reset_tokens_token_hash_unique") @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt      DateTime? @map("used_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  /// Recorded for the audit trail: which address asked for the reset.
  requestedIp String?   @map("requested_ip")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_reset_tokens_tenant_id_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_reset_tokens_user_id_fk")

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model AuditRollback {
  id           String   @id
  tenantId     String   @map("tenant_id")
  /// "asset" | "shot"
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  rolledBackTo DateTime @map("rolled_back_to") @db.Timestamp(6)
  snapshot     Json     @default("{}")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "audit_rollbacks_tenant_id_fk")
  createdBy User?  @relation(fields: [createdById], references: [id], onUpdate: NoAction, map: "audit_rollbacks_created_by_id_fk")

  @@unique([tenantId, entityType, entityId])
  @@map("audit_rollbacks")
}

/// One row per worked shift. This is the attendance record proper, kept
/// separate from `User.punchedInAt` on purpose: that column holds only the
/// *current* punch and is overwritten by the next one, so it can say whether
/// someone is in right now but can never answer "how many hours did she work
/// last week" or "was he in on the 3rd" -- the questions attendance exists to
/// answer. Rows here are append-only history and outlive the punch.
///
/// Opened automatically when someone whose role keeps a timesheet signs in
/// (see AUTO_CLOCK_IN_ROLES in routes/auth.ts) and closed on sign-out. admin
/// and client never get rows: one is an account-administration role, the
/// other an external reviewer, and neither works a studio shift.
model AttendanceRecord {
  id       String @id
  tenantId String @map("tenant_id")
  userId   String @map("user_id")
  /// The calendar date the shift is attributed to, as YYYY-MM-DD in the
  /// studio's timezone. Stored denormalised rather than derived from
  /// clockInAt at query time so a day's roll-up is a plain indexed equality
  /// match, and so a night shift crossing midnight stays on the day it began.
  date       String
  clockInAt  DateTime  @map("clock_in_at") @db.Timestamp(6)
  clockOutAt DateTime? @map("clock_out_at") @db.Timestamp(6)
  /// Whole minutes between the two punches, written when the row is closed.
  /// Precomputed because every report sums it, and recomputing a difference
  /// across thousands of rows on every query is wasted work.
  minutes    Int?
  /// How the row was opened: "login" | "manual".
  source     String    @default("login")
  /// How it was closed: "logout" | "manual" | "auto" (never signed out, closed
  /// by the stale-shift sweep). Null while the shift is still open. Kept
  /// distinct so a report can tell a real clock-out from an inferred one --
  /// an auto-closed shift is an estimate and must not be paid as measured.
  closedBy   String?   @map("closed_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_records_tenant_id_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_records_user_id_fk")

  @@index([tenantId, userId, date])
  @@index([tenantId, date])
  @@map("attendance_records")
}
