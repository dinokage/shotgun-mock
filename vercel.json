{
  "buildCommand": "pnpm --filter @workspace/forge build",
  "outputDirectory": "artifacts/forge/dist/public",
  "framework": null,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./artifacts/forge ./lib",
  "git": {
    "deploymentEnabled": {
      "forge/attendance-ai-review-player": false
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.symbiosystech.in/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
