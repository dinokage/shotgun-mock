# .env.production template for Forge Self-Hosted
# Copy this file to .env and configure the variables for your deployment

# Database settings
POSTGRES_USER=forge_db_user
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=forge

# API settings
API_PORT=3001
JWT_SECRET=replace_this_with_a_secure_random_string

# Web settings
WEB_PORT=80
CORS_ORIGIN=http://your-company-domain.com
# Set to true once this deployment actually terminates HTTPS (a real cert
# in front of nginx, or a load balancer/proxy that does) -- false here would
# leave session cookies sendable over plain HTTP in production.
COOKIE_SECURE=true

# Invite emails (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@your-company-domain.com
SMTP_PASSWORD=replace_with_a_real_app_password
SMTP_FROM_NAME=Forge
FRONTEND_URL=http://your-company-domain.com
