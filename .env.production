# .env.production template for Forge Self-Hosted
# Copy this file to .env and configure the variables for your deployment

# Database settings
POSTGRES_USER=forge_db_user
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_DB=forge

# API settings
API_PORT=3001
JWT_SECRET=replace_this_with_a_secure_random_string

# Web settings
WEB_PORT=80
CORS_ORIGIN=http://your-company-domain.com
